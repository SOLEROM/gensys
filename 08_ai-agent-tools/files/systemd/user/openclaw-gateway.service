[Unit]
Description=OpenClaw Gateway (v2026.3.13)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart={{NODE_BIN}} {{OPENCLAW_JS}} gateway --port {{OPENCLAW_PORT}}
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME={{HOME}}
Environment=TMPDIR=/tmp
Environment=PATH={{HOME}}/.bun/bin:{{HOME}}/.nvm/current/bin:{{HOME}}/.local/bin:{{HOME}}/.npm-global/bin:{{HOME}}/bin:{{HOME}}/.volta/bin:{{HOME}}/.asdf/shims:{{HOME}}/.fnm/current/bin:{{HOME}}/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT={{OPENCLAW_PORT}}
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.3.13

[Install]
WantedBy=default.target
