[Unit]
Description=MD Planner — markdown plan reviewer (Mode 1 server)
Documentation=file://{{MDPLANNER_DIR}}/README.md
After=network-online.target
Wants=network-online.target
# The app dir lives on /data (possibly LUKS, unlocked at boot) — don't race
# the mount at boot; fail cleanly if it never appears.
RequiresMountsFor={{MDPLANNER_DIR}}

[Service]
Type=simple
User={{USERNAME}}
Group={{USERNAME}}
WorkingDirectory={{MDPLANNER_DIR}}
Environment=PYTHONUNBUFFERED=1
# Refresh the Mode-2 standalone bundle on each start (non-fatal: leading '-').
ExecStartPre=-/usr/bin/python3 {{MDPLANNER_DIR}}/build-standalone.py
ExecStart=/usr/bin/python3 {{MDPLANNER_DIR}}/server.py --open-any
Restart=on-failure
RestartSec=2

# Hardening — bounded mode keeps the FS read-only except the root, app dir and the
# on-demand dir(s); --open-any relaxes ProtectSystem/Home so on-demand can write anywhere.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=off
ProtectHome=off
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
