!regolith.wallpaper.file: /usr/share/backgrounds/warty-final-ubuntu.png
!regolith.lockscreen.wallpaper.file: /usr/share/backgrounds/warty-final-ubuntu.png
! BUILD: the WALLPAPER token below is replaced by the build agent with the
! absolute path of the chosen background, i.e. ~/.local/share/backgrounds/imgBg_<N>.jpg
regolith.wallpaper.file: {{WALLPAPER}}
regolith.lockscreen.wallpaper.file: {{WALLPAPER}}

! click the bar clock -> popup calendar. Consumed by the stock
! /usr/share/i3xrocks/scripts/time blocklet (xrescat i3xrocks.action.time),
! so no packaged file needs editing. Needs zenity (installed by this layer).
i3xrocks.action.time: zenity --calendar

! hover a window to focus it (i3 focus_follows_mouse), read via
! set_from_resource in /usr/share/regolith/i3/config.d/40_default-style —
! packaged default is "no" if this resource is unset.
wm.gaps.focus_follows_mouse: yes
