# Anything under secrets/ must never be committed — see secrets/README.md.
# Single tracked exception: the generic README (documents the convention,
# names nothing station-specific). The real inventory (secrets/myReadme.md)
# and the *.example key-name templates stay ignored with everything else —
# they travel only with the manual working-tree copy, never via git.
/secrets/*
!/secrets/README.md


# Python bytecode from 15_firefox/export_bookmarks.py runs
__pycache__/
*.pyc

# Freeze-map snapshots from query/mapCurrentHost.sh — per-host audit data,
# regenerable on any host by re-running the script; layer Origin sections
# cite them by name but the data itself stays local. See query/README.md.
/query/snapshots/

# Exported Firefox bookmarks are personal browsing data — never upload.
# backup.sh regenerates these locally; carry them to the new station the
# same way as secrets/ (manual copy of the repo's working tree), not via
# git. See 15_firefox/README.md.
/15_firefox/bookmarks/*
# This station's per-station folder — everything needed to define and rebuild
# a new station from the myDevX1 dev box: the config yaml, its end-state
# companion doc, and its host-specific alias file. All of it records the
# personal layout (sync folders, agent services, remote hosts, project paths)
# — like secrets/, the folder travels only with the manual working-tree copy,
# never via git.
/00_configs/myDevX1/
